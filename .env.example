# Credenciais da Evolution API — copie para .env e preencha.
# Em produção, cadastre essas mesmas chaves no painel da Vercel/Netlify.

# URL base da sua Evolution (sem barra no final)
EVOLUTION_API_URL=https://evolution.seudominio.com

# Nome da instância conectada ao WhatsApp da M.Dutra
EVOLUTION_INSTANCE=mdutra

# apikey global ou da instância
EVOLUTION_API_KEY=

# JID do grupo que recebe os leads (termina em @g.us)
EVOLUTION_GROUP_ID=
